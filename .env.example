# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cardgames?retryWrites=true&w=majority
MONGODB_DB=cardgames

# Email (Resend) — optional in dev; magic links log to console if unset
RESEND_API_KEY=
RESEND_FROM_EMAIL=Card Games <onboarding@resend.dev>

# PartyKit
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999
PARTYKIT_TOKEN_SECRET=generate-another-long-random-string

# Guest play is always on. Games/stats are not saved for guests.
# ALLOW_DEV_AUTH is unused (kept for backwards compatibility).
ALLOW_DEV_AUTH=false
NEXT_PUBLIC_ALLOW_DEV_AUTH=false
